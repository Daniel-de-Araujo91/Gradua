## Example env for connecting backend to Supabase
# DO NOT commit real credentials. Copy this to backend/.env locally and fill values.
# JDBC URL must include sslmode=require for Supabase
DB_URL=jdbc:postgresql://db.<your-project>.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=<your-db-password>
DB_DRIVER=org.postgresql.Driver
API_KEY=replace_this_in_dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Enable seeds for development only
app.seed.enabled=true
